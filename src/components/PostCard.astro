---
import { render, type CollectionEntry } from "astro:content";
import ArticleCover from "./ArticleCover.astro";
import { getPostUrlBySlug } from "../utils/url-utils";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
interface Props { entry: CollectionEntry<"posts">; style?: string; }
const { entry, style } = Astro.props;
const { remarkPluginFrontmatter } = await render(entry);
const href = getPostUrlBySlug(entry.id);
---
<article class="card-base journal-card" style={style} data-post-id={entry.id}>
  <a href={href} class="journal-cover-link" aria-label={`阅读：${entry.data.title}`}><ArticleCover entry={entry} /></a>
  <div class="journal-copy">
    <div class="journal-meta"><time datetime={entry.data.published.toISOString()}>{formatDateToYYYYMMDD(entry.data.published)}</time><span>{remarkPluginFrontmatter.minutes} 分钟阅读</span></div>
    <h2><a href={href}>{entry.data.title}</a></h2>
    <p>{entry.data.description || remarkPluginFrontmatter.excerpt}</p>
    <footer><span>{entry.data.tags.slice(0,2).map(tag => `#${tag}`).join("  ") || "AIRGLOW JOURNAL"}</span><a href={href} aria-label={`阅读全文：${entry.data.title}`}>阅读 <span aria-hidden="true">↗</span></a></footer>
  </div>
</article>
<style>
  .journal-card{min-width:0;display:flex;flex-direction:column;transition:transform .2s,border-color .2s,box-shadow .2s}
  .journal-card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--primary) 45%,var(--airglow-border));box-shadow:0 10px 28px rgba(0,12,25,.1)}
  .journal-cover-link{display:block;overflow:hidden}.journal-cover-link :global(.article-cover){transition:filter .25s}.journal-cover-link:hover :global(.article-cover){filter:brightness(1.1)}
  .journal-copy{padding:22px 24px 20px;flex:1;display:flex;flex-direction:column}
  .journal-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--airglow-muted);font-size:.68rem;line-height:1.6}
  h2{font-size:1.16rem;font-weight:700;line-height:1.6;margin:12px 0 9px;overflow-wrap:anywhere}h2 a:hover{color:var(--primary)}
  .journal-copy>p{font-size:.8rem;line-height:1.85;color:var(--airglow-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:22px}
  footer{display:flex;justify-content:space-between;gap:12px;align-items:center;border-top:1px solid var(--line-divider);padding-top:15px;margin-top:auto;font-size:.68rem}
  footer>span{color:var(--airglow-muted);overflow-wrap:anywhere;min-width:0}footer a{color:var(--primary);white-space:nowrap}
  @media(max-width:640px){.journal-copy{padding:21px 22px}h2{font-size:1.16rem}}
  @media(prefers-reduced-motion:reduce){.journal-card:hover{transform:none}}
</style>
