---
import type { GetStaticPaths } from "astro";
import Pagination from "../../components/control/Pagination.astro";
import PostPage from "../../components/PostPage.astro";
import FeaturedPost from "../../components/FeaturedPost.astro";
import HomeNotes from "../../components/HomeNotes.astro";
import { PAGE_SIZE } from "../../constants/constants";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const featured = allBlogPosts.find(entry => entry.data.featured && !entry.data.draft) || allBlogPosts.find(entry => !entry.data.draft);
	const regularPosts = allBlogPosts.filter(entry => entry.id !== featured?.id);
	if (!regularPosts.length) {
		return [{
			params: { page: undefined },
			props: { featured, totalPosts: allBlogPosts.length, page: {
				data: [], start: 0, end: 0, size: PAGE_SIZE, total: 0,
				currentPage: 1, lastPage: 1, url: { current: "/blog/", prev: undefined, next: undefined, first: undefined, last: undefined },
			} },
		}];
	}
	return paginate(regularPosts, { pageSize: PAGE_SIZE }).map(route => ({ ...route, props: { ...route.props, featured, totalPosts: allBlogPosts.length } }));
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page, featured, totalPosts } = Astro.props;

const len = page.data.length;
---

<MainGridLayout>
    <h1 class="sr-only">Airglow 的文章与日常记录</h1>
    {page.currentPage === 1 && featured && <FeaturedPost entry={featured} />}
    {page.data.length > 0 && <div class="airglow-section-heading journal-heading">
        <div><p>THE JOURNAL</p><h2>{page.currentPage === 1 ? "更多记录" : "更早的记录"}</h2></div>
        <span>共 {totalPosts} 篇文章</span>
    </div>
    <PostPage page={page}></PostPage>}
    {totalPosts === 0 && <div class="card-base px-9 py-12 text-center text-50">暂时还没有公开文章，新的微光正在酝酿。</div>}
    {page.lastPage > 1 && <Pagination basePath="/blog/" class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`} />}
    {page.currentPage === 1 && <HomeNotes />}
</MainGridLayout>
<style>.journal-heading{background:transparent;border:0;padding:0 4px;margin:0 0 18px}.journal-heading h2{font-size:1.25rem;font-weight:700}.journal-heading>span{font-size:.72rem}.journal-heading p{font-size:.6rem}</style>
